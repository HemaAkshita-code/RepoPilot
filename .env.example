# RepoPilot Environment Configuration (Stage 1)
# Copy this file to .env and replace placeholders with actual values.
# IMPORTANT: Never commit the actual .env file or real API keys to version control.

# Gemma 4 API Key
# Obtain your key from your API provider / Google AI Studio / relevant endpoint.
GEMMA_API_KEY=your_api_key_here

# Gemma 4 Model Identifier
# Person 1 (Backend Lead) will verify and confirm the exact Gemma 4 model string.
# Keep this placeholder until confirmed by Person 1.
GEMMA_MODEL=MODEL_IDENTIFIER_WILL_BE_CONFIRMED
